# %% imports
import os, numpy as np, pandas as pd
import matplotlib.pyplot as plt, seaborn as sns
from scipy.cluster.hierarchy import dendrogram, linkage
from sklearn.datasets import load_wine
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans, AgglomerativeClustering, DBSCAN
from sklearn.metrics import (silhouette_score, silhouette_samples,
                             davies_bouldin_score, calinski_harabasz_score,
                             adjusted_rand_score)

FIG = "figs"
os.makedirs(FIG, exist_ok=True)
sns.set_theme(style="whitegrid", font="DejaVu Sans")
COL = ["#4f81bd", "#c0504d", "#9bbb59", "#8064a2", "#f79646"]

# %% load
wine = load_wine(as_frame=True)
df = wine.frame.copy()
labels_true = df.pop("target")          # kept ONLY for external validation
X = df.copy()
print("Shape:", X.shape)
print("Missing values:", int(X.isna().sum().sum()))
print("Duplicates    :", int(X.duplicated().sum()))
print(X.iloc[:4, :6])

# %% ranges
rng = X.describe().T[["min", "max", "mean", "std"]]
print(rng.round(2))
print("\nLargest / smallest std ratio:",
      round(rng["std"].max() / rng["std"].min(), 1))

# %% scale
scaler = StandardScaler()
Xs = pd.DataFrame(scaler.fit_transform(X), columns=X.columns)
print("Means after scaling (rounded):", Xs.mean().round(6).unique())
print("Std after scaling            :", Xs.std(ddof=0).round(6).unique())
fig, ax = plt.subplots(1, 2, figsize=(14, 5))
sns.boxplot(data=X, orient="h", ax=ax[0], color="#9bbb59")
ax[0].set_title("Raw features: very different ranges"); ax[0].set_xscale("symlog")
sns.boxplot(data=Xs, orient="h", ax=ax[1], color="#4f81bd")
ax[1].set_title("After StandardScaler: comparable ranges")
plt.tight_layout(); plt.savefig(f"{FIG}/w3_scale.png", dpi=150)

# %% corr
plt.figure(figsize=(9.5, 7.5))
sns.heatmap(Xs.corr(), cmap="coolwarm", center=0, annot=True, fmt=".1f",
            annot_kws={"size": 7})
plt.title("Feature correlation matrix (wine chemical analysis)")
plt.tight_layout(); plt.savefig(f"{FIG}/w3_corr.png", dpi=150)
c = Xs.corr().abs().where(np.triu(np.ones((13, 13)), 1).astype(bool)).stack()
print("Strongest correlated pairs:")
print(c.sort_values(ascending=False).head(4).round(2).to_string())

# %% pca
pca = PCA().fit(Xs)
ev = pca.explained_variance_ratio_
print("Explained variance (PC1..PC5):", ev[:5].round(3))
print("Cumulative PC1+PC2          :", round(ev[:2].sum(), 3))
print("Components for 90% variance :", int(np.argmax(ev.cumsum() >= .90) + 1))
Z = PCA(n_components=2, random_state=0).fit_transform(Xs)
fig, ax = plt.subplots(1, 2, figsize=(13, 4.6))
ax[0].bar(range(1, 14), ev, color="#4f81bd", label="Individual")
ax[0].plot(range(1, 14), ev.cumsum(), "o-", color="#c0504d", label="Cumulative")
ax[0].set_xlabel("Principal component"); ax[0].set_ylabel("Explained variance")
ax[0].set_title("PCA scree plot"); ax[0].legend()
ax[1].scatter(Z[:, 0], Z[:, 1], s=28, color="grey", alpha=.8)
ax[1].set_xlabel("PC1"); ax[1].set_ylabel("PC2")
ax[1].set_title("Wines projected on the first two components (unlabelled)")
plt.tight_layout(); plt.savefig(f"{FIG}/w3_pca.png", dpi=150)

# %% choose_k
ks = range(2, 11)
rows = []
for k in ks:
    km = KMeans(n_clusters=k, n_init=20, random_state=42).fit(Xs)
    rows.append((k, km.inertia_, silhouette_score(Xs, km.labels_),
                 davies_bouldin_score(Xs, km.labels_),
                 calinski_harabasz_score(Xs, km.labels_)))
m = pd.DataFrame(rows, columns=["k", "inertia", "silhouette", "davies_bouldin", "calinski"])
print(m.round(3).to_string(index=False))
fig, ax = plt.subplots(1, 3, figsize=(15, 4.2))
ax[0].plot(m.k, m.inertia, "o-", color="#4f81bd"); ax[0].set_title("Elbow method (inertia)")
ax[1].plot(m.k, m.silhouette, "o-", color="#9bbb59"); ax[1].set_title("Mean silhouette score")
ax[2].plot(m.k, m.davies_bouldin, "o-", color="#c0504d"); ax[2].set_title("Davies-Bouldin index (lower = better)")
for a in ax: a.set_xlabel("Number of clusters k")
ax[0].axvline(3, ls="--", color="grey"); ax[1].axvline(3, ls="--", color="grey"); ax[2].axvline(3, ls="--", color="grey")
plt.tight_layout(); plt.savefig(f"{FIG}/w3_choose_k.png", dpi=150)

# %% kmeans
km = KMeans(n_clusters=3, n_init=20, random_state=42).fit(Xs)
cl = km.labels_
print("Cluster sizes:", {int(k): int(v) for k, v in pd.Series(cl).value_counts().sort_index().items()})
print("Silhouette        :", round(silhouette_score(Xs, cl), 3))
print("Davies-Bouldin    :", round(davies_bouldin_score(Xs, cl), 3))
print("Calinski-Harabasz :", round(calinski_harabasz_score(Xs, cl), 1))
fig, ax = plt.subplots(1, 2, figsize=(13, 5))
for k in range(3):
    ax[0].scatter(Z[cl == k, 0], Z[cl == k, 1], s=34, color=COL[k], label=f"Cluster {k}", alpha=.85)
cent = PCA(n_components=2, random_state=0).fit(Xs).transform(km.cluster_centers_)
ax[0].scatter(cent[:, 0], cent[:, 1], marker="X", s=260, c="black", label="Centroids")
ax[0].set_title("K-Means (k = 3) clusters in PCA space"); ax[0].legend()
ax[0].set_xlabel("PC1"); ax[0].set_ylabel("PC2")
sil = silhouette_samples(Xs, cl)
y0 = 0
for k in range(3):
    s = np.sort(sil[cl == k]); ax[1].fill_betweenx(np.arange(y0, y0 + len(s)), 0, s, color=COL[k], alpha=.85)
    ax[1].text(-0.08, y0 + len(s) / 2, f"C{k}"); y0 += len(s) + 6
ax[1].axvline(sil.mean(), color="red", ls="--")
ax[1].set_title("Silhouette plot (red = mean)"); ax[1].set_xlabel("Silhouette coefficient")
ax[1].set_yticks([])
plt.tight_layout(); plt.savefig(f"{FIG}/w3_kmeans.png", dpi=150)

# %% profile
prof = X.copy(); prof["cluster"] = cl
centers = prof.groupby("cluster").mean()
print(centers[["alcohol", "malic_acid", "flavanoids", "color_intensity", "proline"]].round(2))
zc = pd.DataFrame(km.cluster_centers_, columns=X.columns)
plt.figure(figsize=(11, 3.8))
sns.heatmap(zc, annot=True, fmt=".2f", cmap="RdBu_r", center=0, annot_kws={"size": 8},
            yticklabels=[f"Cluster {i}" for i in range(3)])
plt.title("Standardised cluster centroids (red = above average, blue = below)")
plt.xticks(rotation=40, ha="right")
plt.tight_layout(); plt.savefig(f"{FIG}/w3_centroids.png", dpi=150)

# %% radar
sel = ["alcohol", "flavanoids", "total_phenols", "color_intensity", "proline", "malic_acid", "hue"]
ang = np.linspace(0, 2 * np.pi, len(sel), endpoint=False).tolist(); ang += ang[:1]
fig = plt.figure(figsize=(6.5, 6.2)); ax = plt.subplot(111, polar=True)
for k in range(3):
    v = zc.loc[k, sel].tolist(); v += v[:1]
    ax.plot(ang, v, color=COL[k], lw=2, label=f"Cluster {k}"); ax.fill(ang, v, color=COL[k], alpha=.15)
ax.set_xticks(ang[:-1]); ax.set_xticklabels(sel, fontsize=9)
ax.set_title("Cluster fingerprints (standardised means)", pad=22); ax.legend(loc="upper right", bbox_to_anchor=(1.3, 1.1))
plt.tight_layout(); plt.savefig(f"{FIG}/w3_radar.png", dpi=150)

# %% hier
Zl = linkage(Xs, method="ward")
plt.figure(figsize=(12, 4.8))
dendrogram(Zl, truncate_mode="lastp", p=24, leaf_rotation=90, color_threshold=Zl[-3, 2])
plt.axhline(Zl[-3, 2], color="red", ls="--")
plt.title("Ward hierarchical clustering dendrogram (last 24 merges)")
plt.xlabel("Cluster (size in brackets / sample index)"); plt.ylabel("Ward distance")
plt.tight_layout(); plt.savefig(f"{FIG}/w3_dendro.png", dpi=150)
rows = []
for lk in ["ward", "complete", "average", "single"]:
    lab = AgglomerativeClustering(n_clusters=3, linkage=lk).fit_predict(Xs)
    rows.append((lk, silhouette_score(Xs, lab), adjusted_rand_score(labels_true, lab)))
hres = pd.DataFrame(rows, columns=["linkage", "silhouette", "ARI vs cultivar"])
print(hres.round(3).to_string(index=False))
hier = AgglomerativeClustering(n_clusters=3, linkage="ward").fit_predict(Xs)

# %% dbscan
rows = []
for eps in [1.5, 2.0, 2.5, 3.0]:
    lab = DBSCAN(eps=eps, min_samples=5).fit_predict(Xs)
    nc = len(set(lab)) - (1 if -1 in lab else 0)
    rows.append((eps, nc, int((lab == -1).sum())))
print(pd.DataFrame(rows, columns=["eps", "clusters found", "noise points"]).to_string(index=False))

# %% validate
print("K-Means  vs cultivar  ARI:", round(adjusted_rand_score(labels_true, cl), 3))
print("Ward     vs cultivar  ARI:", round(adjusted_rand_score(labels_true, hier), 3))
print("K-Means vs Ward agreement:", round(adjusted_rand_score(cl, hier), 3))
km_raw = KMeans(n_clusters=3, n_init=20, random_state=42).fit(X)
print("K-Means WITHOUT scaling ARI:", round(adjusted_rand_score(labels_true, km_raw.labels_), 3))
ct = pd.crosstab(pd.Series(cl, name="Cluster"), labels_true.map({0: "Cultivar 0", 1: "Cultivar 1", 2: "Cultivar 2"}))
print(ct)
aris = [adjusted_rand_score(cl, KMeans(3, n_init=1, random_state=s).fit_predict(Xs)) for s in range(20)]
print("Stability over 20 random starts (min ARI):", round(min(aris), 3))
plt.figure(figsize=(6.2, 4.2))
sns.heatmap(ct, annot=True, fmt="d", cmap="Blues", cbar=False)
plt.title("Clusters vs true cultivars (validation only)")
plt.tight_layout(); plt.savefig(f"{FIG}/w3_crosstab.png", dpi=150)
